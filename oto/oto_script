#!/usr/bin/env python3
"""oto — Tensile tuning for unsupported AMD GPUs.

Repo-root entry point. Run from the repository root:
    ./oto doctor
    ./oto status
    ./oto tune --dry-run
"""
import sys
from pathlib import Path

