# oto driver configuration
# Precedence: live shell env > .env. TENSILE_ROOT is required and has no
# built-in fallback. ROCm toolchain locations below are probe candidates.
#
# ROCm toolchain is auto-detected across install styles:
#   - AMD installer (Debian/Ubuntu): everything under /opt/rocm[/llvm/bin]
#   - Fedora/RHEL RPM: split across /usr/bin + /usr/lib64/rocm[/llvm/bin]
# Each *_CANDIDATES var is a ':'-separated ordered list; the FIRST entry that
# exists on this host wins. A reference .env that hardcodes one style needs no
# edits to fall back to the other — the probe picks whichever is present.
# A stale explicit value (set but not on disk) is ignored and the chain is used.

# Tensile checkout root (driver shells out to Tensile/bin/Tensile here)
TENSILE_ROOT=

# ROCm install prefix candidates (amd-style `/opt/rocm` first, fedora-style
# `/usr/lib64/rocm` and plain `/usr` as fallbacks).
ROCM_PREFIX_CANDIDATES=/opt/rocm:/usr/lib64/rocm:/usr

# Runtime binaries (hipcc, rocminfo, ...) prepended to the subprocess PATH.
ROCM_BIN_CANDIDATES=/opt/rocm/bin:/usr/bin:/usr/lib64/rocm/bin

# Clang/LLVM toolchain dir used for kernel assembly compilation (prepended to
# PATH so llvm clang++/lld resolve ahead of distro clang).
ROCM_LLVM_BIN_CANDIDATES=/opt/rocm/llvm/bin:/opt/rocm/lib/llvm/bin:/usr/lib64/rocm/llvm/bin:/usr/lib/rocm/llvm/bin

# HIP/HCC assembler emitted via --assembler (kernel assembly compilation).
TENSILE_ASSEMBLER_CANDIDATES=/usr/lib64/rocm/llvm/bin/clang++:/usr/lib/rocm/llvm/bin/clang++:/opt/rocm/llvm/bin/clang++:/opt/rocm/lib/llvm/bin/clang++:/usr/bin/clang++

# Fallback assembler when the primary is absent (sccache/ccache setups).
TENSILE_ASSEMBLER_FALLBACK_CANDIDATES=/usr/lib64/ccache/clang++:/usr/lib/ccache/clang++:/usr/bin/ccache

# ---------------------------------------------------------------------------
# Optional explicit overrides (skip probing; must exist on disk or the chain
# is used instead):
#   ROCM_PATH=/opt/rocm
#   ROCM_BIN=/opt/rocm/bin
#   ROCM_LLVM_BIN=/usr/lib64/rocm/llvm/bin
#   TENSILE_ASSEMBLER=/usr/lib64/rocm/llvm/bin/clang++
#   TENSILE_ASSEMBLER_FALLBACK=/usr/lib64/ccache/clang++