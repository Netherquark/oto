# oto driver configuration
# Precedence: live shell env > .env. TENSILE_ROOT is required and has no
# built-in fallback.
#
# ROCm toolchain is auto-detected across install styles via native tools only:
#   - hipconfig (ROCM_PATH / HIP_PATH / HIP_CLANG_PATH)
#   - shutil.which for binaries on PATH
#   - AMD installer (Debian/Ubuntu): everything under /opt/rocm[/llvm/bin]
#   - Fedora/RHEL RPM: split across /usr/bin + /usr/lib64/rocm[/llvm/bin]

# Tensile checkout root (driver shells out to Tensile/bin/Tensile here).
# Accepts a standalone Tensile checkout OR a rocm-libraries super-repo root
# (Tensile is discovered under projects/Tensile, shared/Tensile,
# shared/tensile, or Tensile/).
TENSILE_ROOT=

# ---------------------------------------------------------------------------
# Optional explicit overrides (skip native probing entirely):
#   ROCM_PATH=/opt/rocm
#   ROCM_BIN=/opt/rocm/bin
#   ROCM_LLVM_BIN=/usr/lib64/rocm/llvm/bin
#   TENSILE_ASSEMBLER=/usr/lib64/rocm/llvm/bin/clang++
#   TENSILE_ASSEMBLER_FALLBACK=/usr/lib64/ccache/clang++
#
# Debug:
#   TENSILE_VERBOSE=1

# CLI
#   OTO_YES=1          accept the default --auto plan without prompting
#   OTO_NO_INPUT=1      never prompt; take documented defaults or fail
#   NO_COLOR=1         disable ANSI colour
#   OTO_QUIET=1         suppress CLI narration
#   OTO_VERBOSE=1       show the command line and full tracebacks