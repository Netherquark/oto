# oto driver configuration
# Precedence: live shell env > .env. TENSILE_ROOT and ROCM_PATH are required
# and have no built-in fallback -- the driver never guesses a toolchain.
# Nothing in this file falls back to /usr, /usr/lib64, /opt/rocm, or hipconfig:
# if you want one of those, you point at it explicitly. Zero exceptions.

# Tensile checkout root (driver shells out to Tensile/bin/Tensile here).
# Accepts a standalone Tensile checkout OR a rocm-libraries super-repo root
# (Tensile is discovered under projects/Tensile, shared/Tensile,
# shared/tensile, or Tensile/).
TENSILE_ROOT=

# ROCm toolchain root. Point it at your ROCm install. Supported layouts:
#   - TheRock python-sdk venv:  .../rocm-nightly-venv/lib/python3.14/site-packages/_rocm_sdk_core
#   - TheRock tarball (dist):   <extracted-root>           (bin/, lib/, include/)
#   - Distro / installer:       /opt/rocm (or /usr on some RPM layouts)
# bin/ and the LLVM toolchain bin/ are derived from ROCM_PATH automatically:
#   - python-sdk:  <ROCM_PATH>/lib/llvm/bin
#   - tarball:     <ROCM_PATH>/llvm/bin (also <ROCM_PATH>/lib/llvm/bin)
#   - distro RPM:  <ROCM_PATH>/lib64/rocm/llvm/bin or <ROCM_PATH>/lib/llvm/bin
# The assembler prefers the SDK's amdclang++ (Tensile's native default) and
# falls back to clang++ in the same dirs; hipcc is NOT auto-selected.
ROCM_PATH=

# HIP is a view into the same ROCm tree unless you carry multiple installs.
# HIP_PATH defaults to ROCM_PATH when unset; setting it explicitly here makes
# the relationship legible at a glance.
HIP_PATH=

# HIP_DEVICE_LIB_PATH / ROCM_DEVICE_LIB_PATH: the AMDGPU bitcode directory.
# Both are derived from ROCM_PATH (lib/llvm/amdgcn/bitcode) when unset. Set
# them only if you keep bitcode outside the ROCm tree (rare).
# HIP_DEVICE_LIB_PATH=<...>/lib/llvm/amdgcn/bitcode
# ROCM_DEVICE_LIB_PATH=<...>/lib/llvm/amdgcn/bitcode

# Optional explicit overrides (every one of these is user-provided, commented
# in .env.example, and verified to exist before use; missing paths are fatal
# with an actionable message, never silently replaced):
#   ROCM_BIN=<ROCM_PATH>/bin
#   ROCM_LLVM_BIN=<see "Supported layouts" above>
#   OTO_TENSILE_CLIENT=/path/to/tensile-client  (MUST be set when TENSILE_ROOT
#          has no build/client/tensile-client; doctor FAILs otherwise. A fresh
#          machine rebuilds via scripts/build_tensile_client.sh, which installs
#          it at <TENSILE_ROOT>/build/client/tensile-client by default)
#   TENSILE_ASSEMBLER=/path/to/amdclang++ (default: <llvm_bin>/amdclang++)
#   TENSILE_CXX_COMPILER=amdclang++ (default: probed from the ROCm tree —
#          <llvm_bin>/amdclang++ preferred; hipcc only if the tree has no clang)
#   TENSILE_C_COMPILER=amdclang   (default: probed from the ROCm tree the same
#          way; a bare name is passed to Tensile verbatim)
#   ROCM_VERSION=7.15.0a20260728 (passed through to the subprocess env;
#                                 helps Tensile skip version probing)
#
# Verify you wired it right: `oto doctor` prints every resolved path with
# existence and a version line from the assembler it will use. If a row fails,
# the problem is your .env or your ROCm install — never us guessing.

# Debug:
#   TENSILE_VERBOSE=1

# CLI
#   OTO_YES=1          accept the default --auto plan without prompting
#   OTO_NO_INPUT=1      never prompt; take documented defaults or fail
#   NO_COLOR=1         disable ANSI colour
#   OTO_QUIET=1         suppress CLI narration

# Device selection (consulted before rocminfo auto-detection; no fallback to a
# guess — an unknown value errors out loudly rather than defaulting silently):
#   OTO_PROFILE=gfx90c    a codename from profiles/, or a path to a profile JSON

# Agent research keys (used by `oto agent consult --with-docs` to emit
# agent-1/agent-2 device docs; absent keys degrade to UNVERIFIED scaffolds
# rather than failing — the consult itself is CPU-only):
#   ANTHROPIC_API_KEY=...
#   OPENAI_API_KEY=...
#   OTO_API_KEY=...
#   OTO_API_ENDPOINT=https://...    # default api.anthropic.com/v1/messages
#   OTO_API_MODEL=claude-...        # default set by oto/agents/research_client.py
#   OTO_API_TIMEOUT=120             # seconds
#   OTO_API_MAX_TOKENS=2048

# Kernel DB auto-rebuild on run completion (disable for seq runners that
# manage their own timing):
#   OTO_NO_AUTO_KERNEL_DB_REBUILD=1

# Reference-phase probe scope used by the verifier gate differential:
#   OTO_ARCHS='["gfx90c", "gfx900", null]'
